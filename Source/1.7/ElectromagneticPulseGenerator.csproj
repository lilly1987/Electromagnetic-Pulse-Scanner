<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{D4A3F83D-CC47-4B63-BF51-C16A4CD1AB77}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>ElectromagneticPulseGenerator</RootNamespace>
    <AssemblyName>ElectromagneticPulseGenerator</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>bin\\Release\\</OutputPath>
    <RimWorldDir>Y:\SteamLibrary\steamapps\common\RimWorld</RimWorldDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\\Microsoft.CSharp.targets" />
  <Target Name="CopyToAssemblies" BeforeTargets="AfterBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)\\..\..\\1.7\Assemblies\\" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)"
          DestinationFolder="$(MSBuildProjectDirectory)\\..\..\\1.7\Assemblies\\"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="AfterBuild">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\bin" Condition="Exists('$(MSBuildProjectDirectory)\bin')" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj" Condition="Exists('$(MSBuildProjectDirectory)\obj')" />
  </Target>
</Project>
